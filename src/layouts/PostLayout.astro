---
import BaseLayout from './BaseLayout.astro';

interface TocItem {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  description: string;
  date: Date;
  series?: string;
  seriesOrder?: number;
  tags?: string[];
  canonicalUrl?: string;
  toc?: TocItem[];
}
const {
  title,
  description,
  date,
  series,
  seriesOrder,
  tags,
  canonicalUrl,
  toc = [],
} = Astro.props;
const dateStr = date.toISOString().slice(0, 10);
const hasToc = toc.length >= 3;
---

<BaseLayout title={title} description={description} canonical={canonicalUrl}>
  <div class="pt-28 sm:pt-32">
    {/* header */}
    <header class="mx-auto max-w-2xl">
      <a
        href="/blog"
        class="font-mono text-sm text-muted transition-colors hover:text-ink"
      >
        ← Blog
      </a>
      <div class="mt-6 flex flex-wrap items-center gap-2 font-mono text-sm text-muted">
        <time datetime={dateStr}>{dateStr}</time>
        {series && (
          <>
            <span class="text-line-strong">·</span>
            <span class="text-accent-ink">
              {series}{seriesOrder ? ` #${seriesOrder}` : ''}
            </span>
          </>
        )}
      </div>
      <h1 class="display mt-4 text-3xl text-ink sm:text-[2.6rem]">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{description}</p>
      {tags && tags.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-2">
          {tags.map((t) => (
            <span class="rounded-md bg-ink px-2.5 py-1 text-xs font-medium text-white">
              {t}
            </span>
          ))}
        </div>
      )}
      {canonicalUrl && (
        <div class="mt-6 flex items-center gap-2 rounded-xl border border-line bg-surface px-4 py-3 text-sm text-ink-soft shadow-sm">
          <span class="font-mono text-xs text-muted">velog</span>
          <span>에서 옮겨온 글입니다.</span>
          <a
            href={canonicalUrl}
            target="_blank"
            rel="noreferrer"
            class="link-underline font-semibold text-accent-ink"
          >
            원문 보기 ↗
          </a>
        </div>
      )}
    </header>

    <hr class="mx-auto mt-8 max-w-2xl border-line" />

    {/* body + toc */}
    <div
      class:list={[
        'mx-auto mt-10 gap-12',
        hasToc ? 'max-w-5xl lg:grid lg:grid-cols-[200px_1fr]' : 'max-w-2xl',
      ]}
    >
      {hasToc && (
        <aside class="hidden lg:block">
          <nav class="sticky top-28">
            <p class="font-mono text-xs uppercase tracking-wider text-muted">목차</p>
            <ul class="mt-3 space-y-2 border-l border-line">
              {toc.map((h) => (
                <li>
                  <a
                    href={`#${h.slug}`}
                    data-toc={h.slug}
                    class:list={[
                      'toc-link -ml-px block border-l border-transparent py-0.5 text-sm text-muted transition-colors hover:text-ink',
                      h.depth === 3 ? 'pl-6' : 'pl-3',
                    ]}
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}

      <article class="prose min-w-0 max-w-2xl">
        <slot />
      </article>
    </div>

    <div class="mx-auto mt-16 max-w-2xl border-t border-line pt-6">
      <a
        href="/blog"
        class="inline-flex items-center gap-1 text-sm font-semibold text-ink transition-all hover:gap-2"
      >
        <span class="text-accent">←</span> 다른 글 보기
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .toc-link.is-active {
    color: var(--color-accent-ink);
    border-color: var(--color-accent);
    font-weight: 600;
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc-link')];
  if (links.length) {
    const map = new Map(links.map((l) => [l.dataset.toc, l]));
    const headings = links
      .map((l) => document.getElementById(l.dataset.toc ?? ''))
      .filter((el): el is HTMLElement => !!el);

    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            links.forEach((l) => l.classList.remove('is-active'));
            map.get(e.target.id)?.classList.add('is-active');
          }
        }
      },
      { rootMargin: '0px 0px -75% 0px', threshold: 1 }
    );
    headings.forEach((h) => io.observe(h));
  }
</script>
