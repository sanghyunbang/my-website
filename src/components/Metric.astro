---
interface Props {
  value: string;
  label: string;
  note?: string;
}
const { value, label, note } = Astro.props;
---

<div class="rounded-2xl border border-line bg-surface p-5">
  <p class="text-2xl font-extrabold tracking-tight text-ink sm:text-[1.7rem]">
    {value}
  </p>
  <p class="mt-1.5 text-sm font-medium text-ink-soft">{label}</p>
  {note && <p class="mt-0.5 font-mono text-xs text-muted">{note}</p>}
</div>
