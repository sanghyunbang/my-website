---
/**
 * 이력서. 모든 사실은 src/data/profile.ts에서 읽는다.
 * public/resume-{ko,en}.pdf는 이 페이지를 인쇄해 만든다: npm run pdf (scripts/build-resume-pdf.mjs)
 * 인쇄 스타일: src/styles/global.css @media print
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useT, localize, type Lang } from '../../i18n';
import {
  person,
  positioning,
  links,
  site,
  experience,
  training,
  education,
  educationDetail,
  certs,
  languages,
  awards,
  skills,
  skillText,
  publishedResumeProjects,
  formatDate,
  formatPeriod,
  formatAward,
  getAward,
  getApp,
  appStatusSuffix,
} from '../../data/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const projects = publishedResumeProjects();
const fullProjects = projects.filter((p) => p.size === 'full');
const lineProjects = projects.filter((p) => p.size === 'line');
// PDF 안의 링크가 localhost를 가리키지 않도록 사이트 절대 URL을 쓴다
const abs = (path: string) => new URL(localize(path, lang), site.url).href;

const Section = 'resume-section grid gap-2 border-t border-line pt-6 sm:grid-cols-[130px_1fr]';
const Keep = `${Section} resume-keep`;
const H2 = 'font-mono text-xs uppercase tracking-wider text-muted';
---

<BaseLayout title={t('resume.title')} description={positioning.meta.resume[lang]}>
  <div class="resume mx-auto max-w-3xl pt-28 pb-8 sm:pt-32">
    <div class="no-print mb-8 flex flex-wrap items-center justify-between gap-3">
      <a href={localize('/about', lang)} class="font-mono text-sm text-muted transition-colors hover:text-ink">← About</a>
      <div class="flex items-center gap-2">
        <a href={links.resumePdf[lang]} class="rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5">{t('resume.pdf')}</a>
        <button type="button" id="print-btn" class="rounded-full border border-line-strong px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:border-ink">{t('resume.print')}</button>
      </div>
    </div>

    <header class="pb-6">
      <h1 class="text-3xl font-extrabold tracking-tight text-ink">
        {person.latinName} <span class="text-xl font-bold text-muted">{person.koreanName}</span>
      </h1>
      <p class="mt-1 font-mono text-sm text-accent-ink">{positioning.role[lang]}</p>
      <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-ink-soft">
        <a href={links.github.href} target="_blank" rel="noreferrer" class="hover:text-ink">{links.github.display}</a>
        <a href={links.site.href} class="hover:text-ink">{links.site.display}</a>
      </div>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-ink-soft">{positioning.summary[lang]}</p>
    </header>

    <div class="resume-sections mt-6 space-y-6">
      <section class={Section}>
        <h2 class={H2}>{t('resume.experience')}</h2>
        <div class="space-y-5">
          {experience.map((e) => (
            <div class="resume-entry">
              <div class="resume-entry-head flex items-baseline justify-between gap-3">
                <p class="min-w-0 flex-1 font-bold text-ink">{e.org[lang]}</p>
                <span class="shrink-0 whitespace-nowrap font-mono text-xs text-muted">{formatPeriod(e.start, e.end, lang)}</span>
              </div>
              <p class="text-sm font-medium text-accent-ink">{e.role[lang]}</p>
              <ul class="mt-1.5 list-disc space-y-1 pl-4 text-sm leading-relaxed text-ink-soft">
                {e.bullets[lang].map((b) => <li>{b}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section class={Section}>
        <h2 class={H2}>{t('resume.projects')}</h2>
        <div class="space-y-5">
          {fullProjects.map((p) => {
            const award = p.award ? getAward(p.award) : undefined;
            const app = p.app ? getApp(p.app) : undefined;
            return (
              <div class="resume-entry">
                <div class="resume-entry-head">
                  <p class="font-bold text-ink">{p.name[lang]}</p>
                  {/* 기간은 제목 아래 메타 줄에 둔다(긴 제목·여러 기간에서도 정렬이 흔들리지 않게). 라벨은 한글이 섞여 sans로 */}
                  <p class="mt-0.5 flex flex-wrap gap-x-3 gap-y-0.5 font-mono text-xs text-ink-soft">
                    <span class="text-muted">
                      {p.periods.map((x, i) => (
                        <>{i > 0 && ' · '}{formatPeriod(x.start, x.end, lang)}{x.label && <span class="font-sans"> ({x.label[lang]})</span>}</>
                      ))}
                    </span>
                    {p.slug && <a href={abs(`/projects/${p.slug}`)} class="text-accent-ink hover:underline">{t('resume.casestudy')} ↗</a>}
                    {app && <a href={app.href} target="_blank" rel="noreferrer" class="text-accent-ink hover:underline">{app.store[lang]}{app.status && <span class="font-sans">{appStatusSuffix(app, lang)}</span>} ↗</a>}
                    {p.note && <span class="font-sans">{p.note[lang]}</span>}
                  </p>
                </div>
                {award && (
                  <p class="mt-1 text-sm font-medium text-ink">🏆 {formatAward(award, lang)}</p>
                )}
                <ul class="mt-1.5 list-disc space-y-1 pl-4 text-sm leading-relaxed text-ink-soft">
                  {p.bullets?.[lang].map((b) => <li>{b}</li>)}
                </ul>
              </div>
            );
          })}

          {lineProjects.length > 0 && (
            <div class="resume-entry">
              <p class="font-semibold text-ink">{t('resume.otherProjects')}</p>
              <ul class="mt-1.5 list-disc space-y-1.5 pl-4 text-sm leading-relaxed text-ink-soft">
                {lineProjects.map((p) => {
                  const award = p.award ? getAward(p.award) : undefined;
                  return (
                    <li>
                      <span class="font-semibold text-ink">{p.name[lang]}</span>
                      <span class="text-xs text-muted">
                        {' · '}
                        {p.periods.map((x, i) => (
                          <>{i > 0 && ' · '}<span class="font-mono">{formatPeriod(x.start, x.end, lang)}</span>{x.label && ` (${x.label[lang]})`}</>
                        ))}
                      </span>
                      {' — '}{p.summary?.[lang]}
                      {award && <span> {t('resume.awardLine')}: {formatAward(award, lang)}.</span>}
                      {p.disclaimer && <span class="text-muted"> {p.disclaimer[lang]}</span>}
                    </li>
                  );
                })}
              </ul>
            </div>
          )}
        </div>
      </section>

      <section class={Keep}>
        <h2 class={H2}>{t('resume.training')}</h2>
        <div class="space-y-3">
          {training.map((x) => (
            <div class="resume-entry flex items-baseline justify-between gap-3">
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-ink">{x.name[lang]}</p>
                <p class="text-sm text-ink-soft">{x.detail[lang]}</p>
              </div>
              <span class="shrink-0 whitespace-nowrap font-mono text-xs text-muted">{formatPeriod(x.start, x.end, lang)}</span>
            </div>
          ))}
        </div>
      </section>

      <section class={Keep}>
        <h2 class={H2}>{t('resume.education')}</h2>
        <div class="space-y-3">
          {education.map((e) => (
            <div class="resume-entry flex items-baseline justify-between gap-3">
              <div class="min-w-0 flex-1">
                <p class="font-semibold text-ink">{e.school[lang]}</p>
                <p class="text-sm text-ink-soft">{educationDetail(e, lang)}</p>
              </div>
              <span class="shrink-0 whitespace-nowrap font-mono text-xs text-muted">{formatPeriod(e.start, e.end, lang)}</span>
            </div>
          ))}
        </div>
      </section>

      <section class={Keep}>
        <h2 class={H2}>{t('resume.skills')}</h2>
        <div class="space-y-2.5">
          {skills.groups.map((s) => (
            <div class="text-sm"><span class="font-semibold text-ink">{s.label[lang]}</span><span class="text-ink-soft"> — {s.items.map((i) => skillText(i, lang)).join(', ')}</span></div>
          ))}
        </div>
      </section>

      <section class={Keep}>
        <h2 class={H2}>{t('resume.certs')}</h2>
        <div class="space-y-3 text-sm text-ink-soft">
          <ul class="list-disc space-y-1 pl-4">
            {certs.map((c) => <li>{c.name[lang]} ({formatDate(c.date, lang)})</li>)}
          </ul>
          <div>
            <span class="font-semibold text-ink">{t('resume.languages')}</span>
            <span> — {languages.map((l) => `${l.name} ${l.score} (${formatDate(l.date, lang)})`).join(' · ')}</span>
          </div>
        </div>
      </section>

      <section class={Keep}>
        <h2 class={H2}>{t('resume.awards')}</h2>
        <ul class="list-disc space-y-1 pl-4 text-sm leading-relaxed text-ink-soft">
          {awards.map((a) => <li>{formatAward(a, lang, { work: true })}</li>)}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  document.getElementById('print-btn')?.addEventListener('click', () => window.print());
</script>
