---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useT, localize, GITHUB_URL, PORTFOLIO_URL, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const keywords = {
  ko: ['#구조적사고', '#데이터기반', '#집요한디버깅', '#끝까지책임', '#계속만든다'],
  en: ['#StructuralThinking', '#DataDriven', '#RelentlessDebugging', '#OwnItFully', '#AlwaysBuilding'],
}[lang];

const intro = {
  ko: [
    '서비스를 직접 만들고 운영하면서, 사용자 요청·데이터·인증·배포가 하나로 이어질 때 개발이 가장 재미있었습니다. Spring 백엔드부터 Flutter 앱까지, 제품이 되는 소프트웨어를 끝까지 책임지려 합니다.',
    "경영·경제를 먼저 공부한 덕에 '왜 이 데이터가 필요한가'를 함께 생각하고, 데이터 분석 경험으로 정량적으로 문제를 바라보는 습관을 들였습니다. 단순히 동작하는 코드가 아니라 동작 이후의 구조까지 확인합니다.",
  ],
  en: [
    "I enjoy building most when a service's user requests, data, auth and deployment all connect end to end. From Spring backends to Flutter apps, I want to own software all the way to a shipped product.",
    "Studying business and economics first taught me to ask “why is this data needed,” and data analysis gave me the habit of looking at problems quantitatively. I check not just that code runs, but the structure behind how it runs.",
  ],
}[lang];

const journey = {
  ko: [
    { org: '레이시스', role: '백엔드 개발자 · ERP 회계 모듈 · Node.js, MariaDB', period: '2026.07 – 현재', mono: 'ERP', grad: 'from-emerald-500 to-teal-600', href: '' },
    { org: '프로그래머스 데브코스', role: 'MSA 기반 Spring AI 심화 캠프 · Spring Cloud · 백엔드 프로젝트(BARO FARM)', period: '2025.11 – 2026.01', mono: 'P', grad: 'from-violet-500 to-fuchsia-600', href: '/projects/baro-farm' },
    { org: '한국관광공사 관광데이터 활용 공모전', role: 'HeatTrip 출품 · 우수상 수상', period: '2025.07 – 2025.11', mono: '🏆', grad: 'from-amber-500 to-orange-500', href: '/projects/heat-trip' },
    { org: '강남 하이미디어 · KDT 풀스택 캠프', role: 'Spring · React · Flutter 풀스택 · 졸업 프로젝트 우수상(HeatTrip)', period: '2025.01 – 2025.07', mono: 'KDT', grad: 'from-sky-500 to-cyan-600', href: '/projects/heat-trip' },
  ],
  en: [
    { org: '레이시스', role: 'Backend Developer · ERP accounting module · Node.js, MariaDB', period: '2026.07 – present', mono: 'ERP', grad: 'from-emerald-500 to-teal-600', href: '' },
    { org: 'Programmers Dev Course', role: 'MSA Spring AI intensive · Spring Cloud · backend project (BARO FARM)', period: '2025.11 – 2026.01', mono: 'P', grad: 'from-violet-500 to-fuchsia-600', href: '/projects/baro-farm' },
    { org: 'Korea Tourism Data Utilization Competition', role: 'Submitted HeatTrip · Excellence Award', period: '2025.07 – 2025.11', mono: '🏆', grad: 'from-amber-500 to-orange-500', href: '/projects/heat-trip' },
    { org: 'Gangnam HiMedia · KDT Full-stack Bootcamp', role: 'Spring · React · Flutter · Excellence Award (HeatTrip)', period: '2025.01 – 2025.07', mono: 'KDT', grad: 'from-sky-500 to-cyan-600', href: '/projects/heat-trip' },
  ],
}[lang];

const education = {
  ko: [
    { school: '학점은행제 · 컴퓨터공학 (졸업 예정)', period: '2025.07 – 2026.08' },
    { school: '서강대학교 · 경영학 / 경제학 복수전공', period: '2015.03 – 2022.05' },
    { school: '중앙대학교 대학원 · AI학과 (휴학)', period: '2022.09 –' },
  ],
  en: [
    { school: 'Credit Bank System · B.S. Computer Science (expected)', period: '2025.07 – 2026.08' },
    { school: 'Sogang University · Business & Economics (double major)', period: '2015.03 – 2022.05' },
    { school: 'Chung-Ang Univ. Graduate School · AI (on leave)', period: '2022.09 –' },
  ],
}[lang];

const contacts = [
  { label: 'GitHub', href: GITHUB_URL },
  { label: 'Portfolio', href: PORTFOLIO_URL },
  { label: 'Resume', href: localize('/resume', lang) },
];
---

<BaseLayout title={t('about.eyebrow')} description={t('about.title')}>
  <section class="pt-28 sm:pt-32">
    <div class="group relative mx-auto w-fit">
      <img src="/img/cat_profile.png" alt="SangHyun Bang" width="288" height="288" class="h-64 w-64 rounded-3xl object-cover transition-all duration-500 group-hover:scale-[1.02] group-hover:grayscale sm:h-72 sm:w-72" />
      <ul class="font-impact pointer-events-none absolute left-full top-1/2 ml-10 hidden -translate-y-1/2 space-y-1.5 text-2xl leading-tight text-ink lg:block xl:text-3xl">
        {keywords.map((k, i) => (
          <li class="whitespace-nowrap translate-x-4 opacity-0 transition-all duration-500 group-hover:translate-x-0 group-hover:opacity-100" style={`transition-delay:${i * 80}ms`}>
            <span class="text-accent">#</span>{k.slice(1)}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto mt-14 max-w-2xl space-y-5 text-lg leading-relaxed text-ink-soft">
    {intro.map((p) => <p>{p}</p>)}
  </section>

  <section class="mt-24">
    <h2 class="display text-center text-3xl text-ink sm:text-4xl">{t('about.journey')}</h2>
    <div class="mx-auto mt-12 max-w-2xl space-y-3">
      {journey.map((j) => {
        const Tag = j.href ? 'a' : 'div';
        return (
          <Tag href={j.href ? localize(j.href, lang) : undefined} class:list={['group flex items-center gap-4 rounded-2xl p-3 transition-colors', j.href ? 'hover:bg-black/[0.03]' : '']}>
            <div class:list={['flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-sm font-bold text-white', j.grad]}>{j.mono}</div>
            <div class="min-w-0 flex-1">
              <p class="font-bold text-ink">{j.org}{j.href && <span class="ml-1.5 text-accent opacity-0 transition-opacity group-hover:opacity-100">→</span>}</p>
              <p class="text-sm text-muted">{j.role}</p>
            </div>
            <span class="shrink-0 text-right font-mono text-xs text-ink-soft sm:text-sm">{j.period}</span>
          </Tag>
        );
      })}
    </div>

    <div class="mx-auto mt-12 max-w-2xl border-t border-line pt-6">
      <p class="font-mono text-xs uppercase tracking-wider text-muted">{t('about.edu')}</p>
      <ul class="mt-3 space-y-1.5">
        {education.map((e) => (
          <li class="flex items-baseline justify-between gap-3 text-sm text-muted">
            <span>{e.school}</span>
            <span class="shrink-0 font-mono text-xs">{e.period}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-8 text-center text-sm text-muted">
      {t('about.resumeHint.pre')}<a href={localize('/resume', lang)} class="link-underline font-semibold text-accent-ink">{t('about.resumeHint.link')}</a>{t('about.resumeHint.post')}
    </p>
  </section>

  <section class="mt-24 border-t border-line pt-12">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="display text-3xl text-ink sm:text-4xl">{t('about.connect')}</h2>
      <p class="max-w-md text-ink-soft">{t('about.connect.sub')}</p>
    </div>
    <div class="mt-7 flex flex-wrap items-center gap-3">
      <a href={localize('/resume', lang)} class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5">{t('about.connect.cta')}</a>
      {contacts.map((c) => (
        <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noreferrer' : undefined} class="link-underline text-sm font-semibold text-ink-soft hover:text-ink">
          {c.label}{c.href.startsWith('http') ? ' ↗' : ''}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
