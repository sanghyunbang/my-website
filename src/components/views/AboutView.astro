---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useT, localize, type Lang } from '../../i18n';
import { person, positioning, education, educationShort, formatPeriod, journey, links } from '../../data/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const keywords = positioning.keywords[lang];
const intro = positioning.intro[lang];
const steps = journey(lang);

// '이력서 보기' 버튼이 /resume로 가므로 같은 곳으로 가는 텍스트 링크는 두지 않는다
const contacts = [
  { label: links.github.label, href: links.github.href },
  { label: t('nav.pdf'), href: links.resumePdf[lang] },
];
const isExternal = (href: string) => href.startsWith('http');
---

<BaseLayout title={t('about.eyebrow')} description={positioning.meta.about[lang]}>
  <section class="pt-28 sm:pt-32">
    <h1 class="sr-only">{person.name[lang]} — {positioning.role[lang]}</h1>
    <div class="group relative mx-auto w-fit">
      <img src={person.avatar.src} alt={person.avatar.alt} width="288" height="288" class="h-64 w-64 rounded-3xl object-cover transition-all duration-500 group-hover:scale-[1.02] group-hover:grayscale sm:h-72 sm:w-72" />
      {keywords.length > 0 && (
        <ul class="font-impact pointer-events-none absolute left-full top-1/2 ml-10 hidden -translate-y-1/2 space-y-1.5 text-2xl leading-tight text-ink lg:block xl:text-3xl">
          {keywords.map((k, i) => (
            <li class="whitespace-nowrap translate-x-4 opacity-0 transition-all duration-500 group-hover:translate-x-0 group-hover:opacity-100" style={`transition-delay:${i * 80}ms`}>
              <span class="text-accent">#</span>{k.slice(1)}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section class="mx-auto mt-14 max-w-2xl space-y-5 text-lg leading-relaxed text-ink-soft">
    <p class="font-mono text-sm font-semibold text-accent-ink">{positioning.role[lang]}</p>
    {intro.map((p) => <p>{p}</p>)}
  </section>

  <section class="mt-24">
    <h2 class="display text-center text-3xl text-ink sm:text-4xl">{t('about.journey')}</h2>
    <div class="mx-auto mt-12 max-w-2xl space-y-3">
      {steps.map((j) => {
        const Tag = j.href ? 'a' : 'div';
        return (
          <Tag href={j.href ? localize(j.href, lang) : undefined} class:list={['group flex items-center gap-4 rounded-2xl p-3 transition-colors', j.href ? 'hover:bg-black/[0.03]' : '']}>
            <div class:list={['flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-sm font-bold text-white', j.grad]}>{j.mono}</div>
            <div class="min-w-0 flex-1">
              <p class="font-bold text-ink">{j.title}{j.href && <span class="ml-1.5 text-accent opacity-0 transition-opacity group-hover:opacity-100">→</span>}</p>
              <p class="text-sm text-muted">{j.sub}</p>
            </div>
            <span class="shrink-0 text-right font-mono text-xs text-ink-soft sm:text-sm">{j.period}</span>
          </Tag>
        );
      })}
    </div>

    <div class="mx-auto mt-12 max-w-2xl border-t border-line pt-6">
      <p class="font-mono text-xs uppercase tracking-wider text-muted">{t('about.edu')}</p>
      <ul class="mt-3 space-y-1.5">
        {education.map((e) => (
          <li class="flex items-baseline justify-between gap-3 text-sm text-muted">
            <span>{educationShort(e, lang)}</span>
            <span class="shrink-0 font-mono text-xs">{formatPeriod(e.start, e.end, lang)}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-8 text-center text-sm text-muted">
      {t('about.resumeHint.pre')}<a href={localize('/resume', lang)} class="link-underline font-semibold text-accent-ink">{t('about.resumeHint.link')}</a>{t('about.resumeHint.post')}
    </p>
  </section>

  <section class="mt-24 border-t border-line pt-12">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="display text-3xl text-ink sm:text-4xl">{t('about.connect')}</h2>
      <p class="max-w-md text-ink-soft">{t('about.connect.sub')}</p>
    </div>
    <div class="mt-7 flex flex-wrap items-center gap-3">
      <a href={localize('/resume', lang)} class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5">{t('about.connect.cta')}</a>
      {contacts.map((c) => (
        <a href={c.href} target={isExternal(c.href) ? '_blank' : undefined} rel={isExternal(c.href) ? 'noreferrer' : undefined} class="link-underline text-sm font-semibold text-ink-soft hover:text-ink">
          {c.label}{isExternal(c.href) ? ' ↗' : ''}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
