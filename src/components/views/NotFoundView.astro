---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useT, localize, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---

<BaseLayout title="404" description={t('notfound.sub')} alternates={false} noindex>
  <section class="flex min-h-[60vh] flex-col items-center justify-center pt-28 text-center sm:pt-32">
    <p class="font-mono text-sm text-accent-ink">404</p>
    <h1 class="display mt-3 text-4xl text-ink sm:text-5xl">{t('notfound.title')}</h1>
    <p class="mt-5 max-w-md text-ink-soft">{t('notfound.sub')}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={localize('/', lang)} class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5">{t('notfound.home')}</a>
      <a href={localize('/projects', lang)} class="rounded-full border border-line-strong px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-ink">{t('notfound.projects')}</a>
    </div>
  </section>
</BaseLayout>
