---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LinkCard from '../LinkCard.astro';
import ProjectRow from '../ProjectRow.astro';
import PostCard from '../PostCard.astro';
import { useT, localize, GITHUB_URL, PORTFOLIO_URL, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const skills = ['Java', 'Spring', 'MSA', 'JPA', 'Kafka', 'Redis', 'Flutter'];

const linkCards = {
  ko: [
    { title: 'Portfolio', href: PORTFOLIO_URL, description: 'Notion 포트폴리오 — 프로젝트 상세와 과정', badge: 'Notion' },
    { title: 'Resume', href: localize('/resume', lang), description: '경력 · 기술 스택 · 프로젝트 이력서', badge: 'Resume' },
    { title: 'GitHub', href: GITHUB_URL, description: '코드 · 실험 프로젝트 · 저장소', badge: 'Code' },
  ],
  en: [
    { title: 'Portfolio', href: PORTFOLIO_URL, description: 'Notion portfolio — project details & process', badge: 'Notion' },
    { title: 'Resume', href: localize('/resume', lang), description: 'Experience · stack · projects', badge: 'Resume' },
    { title: 'GitHub', href: GITHUB_URL, description: 'Code · experiments · repositories', badge: 'Code' },
  ],
}[lang];

const projects = (await getCollection('projects'))
  .filter((p) => p.id.startsWith(`${lang}/`) && p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const recent = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<BaseLayout>
  {/* ── Hero (sky) ── */}
  <section class="full-bleed hero-sky">
    <div class="mx-auto flex min-h-[92vh] max-w-5xl flex-col px-6 pb-8 pt-28 sm:pt-32">
      <div class="flex flex-1 flex-col items-center gap-8 md:flex-row md:items-center md:justify-between">
        <div class="text-center md:text-left">
          <p class="text-lg font-semibold text-white/90">
            {t('home.hey')}<span class="font-extrabold text-white">SangHyun</span>
          </p>
          <h1 class="mt-3 text-white">
            <span class="display block text-6xl sm:text-7xl lg:text-[5.5rem]">software</span>
            <span class="font-script floaty -mt-1 block text-7xl leading-tight sm:text-8xl lg:text-[7rem]">engineer</span>
          </h1>
          <p class="mt-6 text-lg font-medium text-white/95">{t('home.role')}</p>
          <div class="mt-6 flex flex-wrap justify-center gap-2 md:justify-start">
            {skills.map((s) => (
              <span class="rounded-full border border-white/40 bg-white/15 px-3 py-1 font-mono text-xs font-medium text-white backdrop-blur-sm">{s}</span>
            ))}
          </div>
        </div>
        <div class="shrink-0">
          <div class="floaty relative">
            <img src="/img/cat_profile.png" alt="SangHyun Bang" width="280" height="280" class="h-52 w-52 rounded-full border-4 border-white/70 object-cover shadow-2xl shadow-blue-900/20 sm:h-64 sm:w-64 lg:h-72 lg:w-72" />
          </div>
        </div>
      </div>
      <div class="mt-10 flex items-center justify-between font-mono text-xs uppercase tracking-wider text-ink-soft">
        <span>{t('home.based')}</span>
        <span class="hidden sm:inline">Build + Operate</span>
      </div>
    </div>
  </section>

  {/* ── CTA ── */}
  <section class="flex flex-wrap items-center gap-3 pt-12">
    <a href={localize('/projects', lang)} class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5">{t('home.cta.projects')}</a>
    <a href={localize('/about', lang)} class="rounded-full border border-line-strong px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-ink">{t('home.cta.about')}</a>
    <span class="ml-auto inline-flex items-center gap-1.5 font-mono text-sm text-emerald-600">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>{t('home.open')}
    </span>
  </section>

  {/* ── Selected Work ── */}
  <section class="reveal border-t border-line pt-14">
    <div class="flex items-end justify-between">
      <div>
        <p class="font-mono text-sm text-accent-ink">{t('home.work.label')}</p>
        <h2 class="display mt-2 text-3xl text-ink">{t('home.work.title')}</h2>
      </div>
      <a href={localize('/projects', lang)} class="link-underline text-sm font-semibold text-ink">{t('home.work.all')}</a>
    </div>
    <div class="mt-8 space-y-12">
      {projects.map((p, i) => (
        <ProjectRow
          title={p.data.title} slug={p.id.split('/').pop()!} summary={p.data.summary}
          tech={p.data.tech} highlight={p.data.highlight} award={p.data.award}
          index={i} lang={lang} cta={t('proj.viewmore')}
        />
      ))}
    </div>
  </section>

  {/* ── Writing ── */}
  {recent.length > 0 && (
    <section class="reveal mt-24 border-t border-line pt-14">
      <div class="flex items-end justify-between">
        <div>
          <p class="font-mono text-sm text-accent-ink">{t('home.writing.label')}</p>
          <h2 class="display mt-2 text-3xl text-ink">{t('home.writing.title')}</h2>
        </div>
        <a href="/blog" class="link-underline text-sm font-semibold text-ink">{t('home.writing.all')}</a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {recent.map((p, i) => (
          <PostCard title={p.data.title} slug={p.id} description={p.data.description} date={p.data.date} tags={p.data.tags} index={i} />
        ))}
      </div>
    </section>
  )}

  {/* ── Elsewhere ── */}
  <section class="reveal mt-24 border-t border-line pt-14">
    <p class="font-mono text-sm text-accent-ink">{t('home.links.label')}</p>
    <h2 class="display mt-2 text-3xl text-ink">{t('home.links.title')}</h2>
    <div class="mt-8 grid gap-3">
      {linkCards.map((card) => <LinkCard {...card} />)}
    </div>
  </section>
</BaseLayout>
