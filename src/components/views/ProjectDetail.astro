---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Metric from '../Metric.astro';
import RoleBar from '../RoleBar.astro';
import TechBadge from '../TechBadge.astro';
import StatusBadge from '../StatusBadge.astro';
import { useT, localize, type Lang } from '../../i18n';
import { getAward, formatAward, storeLinksFor, resumeProjects, formatProjectPeriods } from '../../data/profile';
import { getProjects, projectSlug } from '../../lib/content';

interface Props {
  lang: Lang;
  project: CollectionEntry<'projects'>;
}
const { lang, project } = Astro.props;
const { data } = project;
const slug = projectSlug(project);
const { Content } = await render(project);
const t = useT(lang);

// 수상: 명칭·날짜는 profile.ts 한 곳에서. 수상은 머리의 칩에만 보여 준다(지표 칸에 다시 넣지 않는다, concept §2)
const award = data.award ? getAward(data.award) : undefined;
const metrics = data.metrics;
// 지표 칸 수에 맞춰 열 수를 정한다(2칸이면 2열 — 3열 줄에 빈 칸이 남지 않게)
const metricCols = metrics.length >= 3 ? 'sm:grid-cols-3' : metrics.length === 2 ? 'sm:grid-cols-2' : '';

// 링크: frontmatter + profile.ts의 스토어 링크
const links = [...data.links, ...storeLinksFor(slug, lang)];

// 기간: frontmatter period가 없으면 profile.ts resumeProjects(같은 id)의 기간
const rp = resumeProjects.find((p) => p.id === slug);
const periodText = data.period ?? (rp ? formatProjectPeriods(rp, lang) : undefined);

// 다른 언어판이 있을 때만 hreflang
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const hasOther = (await getProjects(other, 'case')).some((p) => projectSlug(p) === slug);
---

<BaseLayout title={data.title} description={data.summary} image={data.ogImage ?? data.cover} imageAlt={data.coverAlt} alternates={hasOther} type="article">
  <article class="project-detail pt-28 pb-14 sm:pt-32">
    <a href={localize('/projects', lang)} class="font-mono text-sm text-muted transition-colors hover:text-ink">
      {t('proj.detail.back')}
    </a>

    <header class="mt-6 border-b border-line pb-10">
      <div class="flex flex-wrap items-center gap-2">
        <StatusBadge slug={slug} lang={lang} />
        {award && (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">
            🏆 {formatAward(award, lang)}
          </span>
        )}
      </div>
      <h1 class="display mt-4 text-5xl text-ink sm:text-6xl">{data.title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">{data.summary}</p>

      <div class="mt-7 flex flex-wrap gap-x-10 gap-y-3">
        {data.role && (
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-muted">{t('proj.detail.role')}</p>
            <p class="mt-0.5 text-sm font-medium text-ink">{data.role}</p>
          </div>
        )}
        {periodText && (
          <div>
            <p class="font-mono text-xs uppercase tracking-wider text-muted">{t('proj.detail.period')}</p>
            <p class="mt-0.5 text-sm font-medium text-ink">{periodText}</p>
          </div>
        )}
      </div>

      <div class="mt-6 flex flex-wrap gap-2">
        {data.tech.map((x) => <TechBadge label={x} />)}
      </div>

      {links.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-4">
          {links.map((l) => (
            <a href={l.href} target="_blank" rel="noreferrer" class="link-underline text-sm font-semibold text-accent-ink">
              {l.label} ↗
            </a>
          ))}
        </div>
      )}
    </header>

    {data.cover && (
      <figure id="cover" class="mt-10 scroll-mt-24">
        {/* Figure와 같이 원본 파일로 가는 링크 — 구조도처럼 작은 글씨가 있는 커버를 원본 크기로 볼 수 있게 */}
        <a href={data.cover} target="_blank" rel="noopener" title={lang === 'en' ? 'Open full size in a new tab' : '새 탭에서 원본 크기로 보기'} class="block cursor-zoom-in">
          <img
            src={data.cover}
            alt={data.coverAlt ?? data.title}
            width={data.coverWidth}
            height={data.coverHeight}
            class="aspect-video w-full rounded-2xl border border-line bg-neutral-100 object-contain"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </a>
        {data.coverCaption && (
          <figcaption class="mt-2 text-center font-mono text-xs text-muted">{data.coverCaption}</figcaption>
        )}
      </figure>
    )}

    {metrics.length > 0 && (
      <div class:list={['mt-10 grid gap-4', metricCols]}>
        {metrics.map((m) => <Metric value={m.value} label={m.label} note={m.note} />)}
      </div>
    )}

    {data.roleBreakdown.length > 0 && (
      <div class="mt-10 rounded-2xl border border-line bg-surface p-6 sm:p-7">
        <h2 class="font-mono text-sm text-muted">{t('proj.detail.roles')}</h2>
        <div class="mt-5 max-w-lg">
          <RoleBar items={data.roleBreakdown} />
        </div>
      </div>
    )}

    <div class="prose mt-12 max-w-2xl">
      <Content />
    </div>

    <div class="mt-16 border-t border-line pt-6">
      <a href={localize('/projects', lang)} class="inline-flex items-center gap-1 text-sm font-semibold text-ink transition-all hover:gap-2">
        {t('proj.detail.more')}
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  /* 본문의 넓은 그림(Figure wide)이 이 폭(100cqi)까지 펴진다 */
  .project-detail { container-type: inline-size; }
</style>
