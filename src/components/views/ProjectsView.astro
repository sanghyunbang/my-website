---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../ProjectRow.astro';
import ProjectBrief from '../ProjectBrief.astro';
import { useT, type Lang } from '../../i18n';
import { getProjects, projectSlug } from '../../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const cases = await getProjects(lang, 'case');
const briefs = await getProjects(lang, 'brief');
---

<BaseLayout title={t('projects.title')} description={t('projects.sub')}>
  <section class="pt-28 pb-12 sm:pt-32">
    <p class="font-mono text-sm text-accent-ink">{t('projects.eyebrow')}</p>
    <h1 class="display mt-3 text-5xl text-ink sm:text-6xl">{t('projects.title')}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">{t('projects.sub')}</p>
  </section>

  <div class="space-y-14 border-t border-line pt-12">
    {cases.map((p, i) => (
      <ProjectRow
        title={p.data.title}
        slug={projectSlug(p)}
        summary={p.data.summary}
        tech={p.data.tech}
        highlight={p.data.highlight}
        award={p.data.award}
        cover={p.data.cover}
        coverAlt={p.data.coverAlt}
        index={i}
        lang={lang}
        cta={t('proj.viewmore')}
      />
    ))}
  </div>

  {briefs.length > 0 && (
    <section class="mt-24 border-t border-line pt-12">
      <h2 class="display text-3xl text-ink">{t('projects.other')}</h2>
      <p class="mt-3 text-ink-soft">{t('projects.other.sub')}</p>
      <div class="mt-8 space-y-5">
        {briefs.map((p) => (
          <ProjectBrief
            slug={projectSlug(p)}
            lang={lang}
            title={p.data.title}
            summary={p.data.summary}
            period={p.data.period}
            role={p.data.role}
            tech={p.data.tech}
            award={p.data.award}
            cover={p.data.cover}
            coverAlt={p.data.coverAlt}
            disclaimer={p.data.disclaimer}
            links={p.data.links}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
