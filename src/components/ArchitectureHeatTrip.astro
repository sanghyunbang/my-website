---
// HeatTrip 시스템 아키텍처 — 인라인 SVG (테마 색상 연동)
import { getLang } from '../i18n';
const lang = getLang(Astro.url);
const L = lang === 'en'
  ? { cdn: 'Image CDN', tour: 'Tourism / Location', slack: 'Slack alerts', cross: 'Cross-cutting', caption: 'HeatTrip backend architecture', aria: 'HeatTrip system architecture diagram' }
  : { cdn: '이미지 CDN', tour: '관광/위치 데이터', slack: 'Slack 알림', cross: 'Cross-cutting', caption: 'HeatTrip 백엔드 아키텍처', aria: 'HeatTrip 시스템 아키텍처 다이어그램' };
---

<figure class="my-8 not-prose">
  <div class="rounded-2xl border border-line bg-surface p-4 sm:p-6">
    <svg
      viewBox="0 0 900 470"
      role="img"
      aria-label={L.aria}
      class="block h-auto w-full"
      font-family="var(--font-sans)"
    >
      <defs>
        <marker id="ah" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
          <path d="M0,0 L9,4.5 L0,9 z" fill="#9ca3af" />
        </marker>
        <marker id="ahb" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">
          <path d="M0,0 L9,4.5 L0,9 z" fill="#2563eb" />
        </marker>
      </defs>

      <!-- styles -->
      <style>
        .box { fill: #ffffff; stroke: #e7e7e7; stroke-width: 1.5; }
        .lbl { fill: #0a0a0a; font-weight: 700; font-size: 15px; }
        .sub { fill: #6b7280; font-size: 12px; font-family: var(--font-mono); }
        .chip { fill: #fafafa; stroke: #e7e7e7; stroke-width: 1; }
        .chiptxt { fill: #404040; font-size: 12px; font-weight: 500; }
        .flow { stroke: #9ca3af; stroke-width: 1.5; fill: none; }
        .flowkey { stroke: #2563eb; stroke-width: 2; fill: none; }
        .elabel { fill: #6b7280; font-size: 11px; font-family: var(--font-mono); }
        .accenttxt { fill: #1d4ed8; font-weight: 700; font-size: 15px; }
      </style>

      <!-- Client -->
      <rect class="box" x="20" y="150" width="150" height="92" rx="12" />
      <text class="lbl" x="95" y="186" text-anchor="middle">Flutter App</text>
      <text class="sub" x="95" y="208" text-anchor="middle">Mobile Client</text>

      <!-- Backend (center) -->
      <rect class="box" x="300" y="70" width="290" height="320" rx="16" />
      <text class="accenttxt" x="320" y="100">Spring Boot 3.5 · Java 21</text>
      <text class="sub" x="320" y="120">REST API · Spring Security · JPA</text>

      <!-- domain chips -->
      <g>
        <rect class="chip" x="320" y="138" width="116" height="30" rx="8" />
        <text class="chiptxt" x="378" y="157" text-anchor="middle">Explore</text>
        <rect class="chip" x="446" y="138" width="124" height="30" rx="8" />
        <text class="chiptxt" x="508" y="157" text-anchor="middle">Curation · Rec</text>
        <rect class="chip" x="320" y="176" width="116" height="30" rx="8" />
        <text class="chiptxt" x="378" y="195" text-anchor="middle">Bookmark</text>
        <rect class="chip" x="446" y="176" width="124" height="30" rx="8" />
        <text class="chiptxt" x="508" y="195" text-anchor="middle">Schedule</text>
        <rect class="chip" x="320" y="214" width="116" height="30" rx="8" />
        <text class="chiptxt" x="378" y="233" text-anchor="middle">Media</text>
        <rect class="chip" x="446" y="214" width="124" height="30" rx="8" />
        <text class="chiptxt" x="508" y="233" text-anchor="middle">Auth · OAuth2</text>
      </g>

      <!-- cross-cutting -->
      <line x1="320" y1="262" x2="570" y2="262" stroke="#e7e7e7" stroke-width="1" />
      <text class="sub" x="320" y="284">{L.cross}</text>
      <g>
        <rect class="chip" x="320" y="296" width="80" height="26" rx="8" />
        <text class="chiptxt" x="360" y="313" text-anchor="middle">JWT</text>
        <rect class="chip" x="408" y="296" width="96" height="26" rx="8" />
        <text class="chiptxt" x="456" y="313" text-anchor="middle">Rate Limit</text>
        <rect class="chip" x="512" y="296" width="58" height="26" rx="8" />
        <text class="chiptxt" x="541" y="313" text-anchor="middle">AOP</text>
      </g>
      <g>
        <rect class="chip" x="320" y="328" width="120" height="26" rx="8" />
        <text class="chiptxt" x="380" y="345" text-anchor="middle">correlation id</text>
        <rect class="chip" x="448" y="328" width="122" height="26" rx="8" />
        <text class="chiptxt" x="509" y="345" text-anchor="middle">{L.slack}</text>
      </g>
      <text class="sub" x="320" y="378">Port / Adapter · Docker Compose</text>

      <!-- Right: data + external -->
      <rect class="box" x="700" y="62" width="180" height="56" rx="12" />
      <text class="lbl" x="790" y="86" text-anchor="middle">MySQL 8</text>
      <text class="sub" x="790" y="104" text-anchor="middle">Read Model · FULLTEXT</text>

      <rect class="box" x="700" y="132" width="180" height="56" rx="12" />
      <text class="lbl" x="790" y="156" text-anchor="middle">S3 · CloudFront</text>
      <text class="sub" x="790" y="174" text-anchor="middle">{L.cdn}</text>

      <rect class="box" x="700" y="202" width="180" height="56" rx="12" />
      <text class="lbl" x="790" y="226" text-anchor="middle">Tour · Kakao API</text>
      <text class="sub" x="790" y="244" text-anchor="middle">{L.tour}</text>

      <rect class="box" x="700" y="272" width="180" height="56" rx="12" />
      <text class="lbl" x="790" y="296" text-anchor="middle">Google·Kakao·Naver</text>
      <text class="sub" x="790" y="314" text-anchor="middle">OAuth2 Provider</text>

      <!-- Bottom: LLM recommender -->
      <rect class="box" x="300" y="408" width="290" height="50" rx="12" />
      <text class="lbl" x="320" y="431">Python LLM Recommender</text>
      <text class="sub" x="320" y="448">OpenAI · /recommend</text>

      <!-- flows -->
      <!-- client -> backend -->
      <path class="flowkey" d="M170,196 L300,196" marker-end="url(#ahb)" />
      <text class="elabel" x="235" y="188" text-anchor="middle">REST</text>
      <!-- backend -> data -->
      <path class="flow" d="M590,150 L700,95" marker-end="url(#ah)" />
      <path class="flow" d="M590,170 L700,160" marker-end="url(#ah)" />
      <path class="flow" d="M590,210 L700,228" marker-end="url(#ah)" />
      <path class="flow" d="M590,250 L700,298" marker-end="url(#ah)" />
      <!-- backend <-> LLM (port/adapter) -->
      <path class="flowkey" d="M445,390 L445,408" marker-end="url(#ahb)" />
      <text class="elabel" x="455" y="403">Port / Adapter</text>
    </svg>
  </div>
  <figcaption class="mt-3 text-center font-mono text-xs text-muted">
    {L.caption}
  </figcaption>
</figure>
