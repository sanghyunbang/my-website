---
interface Props {
  src?: string;
  alt?: string;
  caption?: string;
  /** when no real asset yet, render a labeled placeholder slot */
  placeholder?: string;
  ratio?: string; // e.g. "16/9", "4/3"
}
const { src, alt = '', caption, placeholder, ratio = '16/9' } = Astro.props;
---

<figure class="my-6">
  {src ? (
    <img
      src={src}
      alt={alt}
      class="w-full rounded-2xl border border-line object-cover"
      style={`aspect-ratio:${ratio}`}
      loading="lazy"
    />
  ) : (
    <div
      class="flex w-full flex-col items-center justify-center gap-2 rounded-2xl border border-dashed border-line-strong bg-surface text-center"
      style={`aspect-ratio:${ratio}`}
    >
      <span class="font-mono text-xs uppercase tracking-wider text-muted">image slot</span>
      {placeholder && <span class="max-w-xs px-4 text-sm text-muted">{placeholder}</span>}
    </div>
  )}
  {caption && (
    <figcaption class="mt-2 text-center font-mono text-xs text-muted">{caption}</figcaption>
  )}
</figure>
