---
interface Props {
  items: { area: string; pct: number }[];
}
const { items } = Astro.props;
---

<div class="space-y-3">
  {items.map((it) => (
    <div>
      <div class="flex items-baseline justify-between">
        <span class="text-sm font-medium text-ink">{it.area}</span>
        <span class="font-mono text-xs text-muted">{it.pct}%</span>
      </div>
      <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-line">
        <div class="h-full rounded-full bg-accent" style={`width:${it.pct}%`}></div>
      </div>
    </div>
  ))}
</div>
