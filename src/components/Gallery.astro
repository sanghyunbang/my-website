---
/**
 * 세로 폰 스크린샷 여러 장을 반응형 그리드로. .mdx에서:
 *   import Gallery from '../../../components/Gallery.astro';
 *   <Gallery images={[
 *     { src: '/img/projects/pawloop/01-map.webp', alt: '지도 화면', caption: '지도' },
 *     { src: '/img/projects/pawloop/03-walk.webp', alt: '산책 기록 화면', caption: '산책 기록' },
 *   ]} />
 *
 * - 2열(모바일) → cols열(sm 이상, 기본 3). 마지막 줄이 덜 차면 가운데로 모은다
 * - 모든 칸은 같은 세로 비율 틀(ratio, 기본 9/19.5)에 contain으로 맞춰 잘리지 않는다
 * - 비율이 서로 다른 어두운 화면은 frameBg(틀 배경색)와 position(예: 'top')으로 여백을 화면 배경에 맞춘다
 * - loading="lazy", decoding="async"
 * - src가 빈 항목은 건너뛴다(자리표시를 배포하지 않음)
 */
interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}
interface Props {
  images: GalleryImage[];
  /** sm 이상 열 수 */
  cols?: 2 | 3 | 4;
  /** 칸 비율, 예: "9/19.5"(1080×2340), "9/16" */
  ratio?: string;
  caption?: string;
  /** 틀 배경색 (기본: 연회색). 어두운 화면이면 화면 배경색을 넣는다 */
  frameBg?: string;
  /** object-position (기본 center) */
  position?: string;
}
const { images, cols = 3, ratio = '9/19.5', caption, frameBg, position } = Astro.props;
const items = images.filter((i) => i.src);
const imgStyle = [`aspect-ratio:${ratio}`, frameBg && `background-color:${frameBg}`, position && `object-position:${position}`]
  .filter(Boolean)
  .join(';');
---

{items.length > 0 && (
  <figure class="gallery not-prose my-8">
    <ul class="gallery-grid" style={`--cols:${cols}`}>
      {items.map((img) => (
        <li class="m-0 list-none p-0">
          <img
            src={img.src}
            alt={img.alt}
            width={img.width}
            height={img.height}
            class:list={['gallery-img block w-full rounded-xl border border-line object-contain', !frameBg && 'bg-neutral-100']}
            style={imgStyle}
            loading="lazy"
            decoding="async"
          />
          {img.caption && <p class="mt-1.5 text-center font-mono text-xs text-muted">{img.caption}</p>}
        </li>
      ))}
    </ul>
    {caption && <figcaption class="mt-3 text-center font-mono text-xs text-muted">{caption}</figcaption>}
  </figure>
)}

<style>
  /* .prose의 ul/li/img 기본 여백·불릿을 덮어쓴다 */
  .gallery ul { margin: 0; padding: 0; list-style: none; }
  .gallery li { margin: 0; }
  .gallery :global(img.gallery-img) { margin: 0; border-radius: 0.75rem; }

  /* flex로 열을 만들어 마지막 줄이 덜 차면 가운데 정렬 (2열 → sm 이상 --cols열) */
  .gallery-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .gallery-grid > li { flex: 0 0 calc((100% - 0.75rem) / 2); min-width: 0; }
  @media (min-width: 640px) {
    .gallery-grid { gap: 1rem; }
    .gallery-grid > li { flex-basis: calc((100% - (var(--cols) - 1) * 1rem) / var(--cols)); }
  }
</style>
