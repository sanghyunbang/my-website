---
/**
 * 세로 폰 스크린샷 여러 장을 반응형 그리드로. .mdx에서:
 *   import Gallery from '../../../components/Gallery.astro';
 *   <Gallery images={[
 *     { src: '/img/projects/pawloop/01-map.webp', alt: '지도 화면', caption: '지도' },
 *     { src: '/img/projects/pawloop/03-walk.webp', alt: '산책 기록 화면', caption: '산책 기록' },
 *   ]} />
 *
 * - 2열(모바일) → cols열(sm 이상, 기본 3)
 * - 모든 칸은 같은 세로 비율 틀(ratio, 기본 9/19.5)에 contain으로 맞춰 잘리지 않는다
 * - loading="lazy", decoding="async"
 * - src가 빈 항목은 건너뛴다(자리표시를 배포하지 않음)
 */
interface GalleryImage {
  src: string;
  alt: string;
  caption?: string;
  width?: number;
  height?: number;
}
interface Props {
  images: GalleryImage[];
  /** sm 이상 열 수 */
  cols?: 2 | 3 | 4;
  /** 칸 비율, 예: "9/19.5"(1080×2340), "9/16" */
  ratio?: string;
  caption?: string;
}
const { images, cols = 3, ratio = '9/19.5', caption } = Astro.props;
const items = images.filter((i) => i.src);
const colClass = { 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-3', 4: 'sm:grid-cols-4' }[cols];
---

{items.length > 0 && (
  <figure class="gallery not-prose my-8">
    <ul class:list={['grid grid-cols-2 gap-3 sm:gap-4', colClass]}>
      {items.map((img) => (
        <li class="m-0 list-none p-0">
          <img
            src={img.src}
            alt={img.alt}
            width={img.width}
            height={img.height}
            class="gallery-img block w-full rounded-xl border border-line bg-neutral-100 object-contain"
            style={`aspect-ratio:${ratio}`}
            loading="lazy"
            decoding="async"
          />
          {img.caption && <p class="mt-1.5 text-center font-mono text-xs text-muted">{img.caption}</p>}
        </li>
      ))}
    </ul>
    {caption && <figcaption class="mt-3 text-center font-mono text-xs text-muted">{caption}</figcaption>}
  </figure>
)}

<style>
  /* .prose의 ul/li/img 기본 여백·불릿을 덮어쓴다 */
  .gallery ul { margin: 0; padding: 0; list-style: none; }
  .gallery li { margin: 0; }
  .gallery :global(img.gallery-img) { margin: 0; border-radius: 0.75rem; }
</style>
