---
/**
 * "그 밖의 프로젝트" 짧은 항목 (kind: brief). 상세 페이지로 가는 링크는 없고,
 * frontmatter에 links가 있을 때만 외부 링크를 단다.
 * 기간은 frontmatter period가 없으면 src/data/profile.ts resumeProjects(같은 id)의 기간을 쓴다.
 */
import TechBadge from './TechBadge.astro';
import type { Lang } from '../i18n';
import { getAward, formatAward, resumeProjects, formatProjectPeriods, type AwardId } from '../data/profile';

interface Props {
  slug: string;
  lang: Lang;
  title: string;
  summary: string;
  period?: string;
  role?: string;
  tech: string[];
  award?: AwardId;
  cover?: string;
  coverAlt?: string;
  disclaimer?: string;
  links: { label: string; href: string }[];
}
const { slug, lang, title, summary, period, role, tech, award, cover, coverAlt, disclaimer, links } = Astro.props;
const rp = resumeProjects.find((p) => p.id === slug);
const periodText = period ?? (rp ? formatProjectPeriods(rp, lang) : undefined);
const awardText = award ? formatAward(getAward(award), lang) : undefined;
---

<article class="grid gap-5 rounded-2xl border border-line bg-surface p-6 sm:grid-cols-[1fr_auto]">
  <div class="min-w-0">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
      <h3 class="text-xl font-bold tracking-tight text-ink">{title}</h3>
      {periodText && <span class="font-mono text-xs text-muted">{periodText}</span>}
    </div>
    {role && <p class="mt-1 text-sm font-medium text-accent-ink">{role}</p>}
    {awardText && (
      <p class="mt-3 inline-flex items-center gap-1.5 rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-700">
        🏆 {awardText}
      </p>
    )}
    <p class="mt-3 text-[15px] leading-relaxed text-ink-soft">{summary}</p>
    {tech.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tech.map((x) => <TechBadge label={x} />)}
      </div>
    )}
    {links.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-4">
        {links.map((l) => (
          <a href={l.href} target="_blank" rel="noreferrer" class="link-underline text-sm font-semibold text-accent-ink">
            {l.label} ↗
          </a>
        ))}
      </div>
    )}
    {disclaimer && <p class="mt-4 text-xs text-muted">※ {disclaimer}</p>}
  </div>
  {cover && (
    <img
      src={cover}
      alt={coverAlt ?? title}
      class="aspect-video w-full rounded-xl border border-line bg-neutral-100 object-contain sm:w-48"
      loading="lazy"
      decoding="async"
    />
  )}
</article>
