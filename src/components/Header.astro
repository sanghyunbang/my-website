---
import { getLang, localize, altLangPath, useT } from '../i18n';
import { links, person } from '../data/profile';
import { getPublishedPosts } from '../lib/content';

const lang = getLang(Astro.url);
const t = useT(lang);

// 공개 글이 0편이면 Blog 메뉴를 숨긴다
const hasPosts = (await getPublishedPosts()).length > 0;

const nav = [
  { href: localize('/about', lang), label: t('nav.about'), match: '/about' },
  { href: localize('/projects', lang), label: t('nav.work'), match: '/projects' },
  ...(hasPosts ? [{ href: '/blog', label: t('nav.blog'), match: '/blog' }] : []), // 블로그는 한국어만
  { href: localize('/resume', lang), label: t('nav.resume'), match: '/resume' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const bare = path === '/en' || path.startsWith('/en/') ? path.replace(/^\/en/, '') || '/' : path;
const isActive = (m: string) => bare === m || bare.startsWith(m + '/');

const koHref = altLangPath(Astro.url, 'ko');
const enHref = altLangPath(Astro.url, 'en');
---

<div class="no-print pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center px-4 py-4">
  <nav
    class="pointer-events-auto flex items-center gap-1 rounded-full border border-black/5 bg-white/80 p-1.5 shadow-[0_8px_30px_rgba(0,0,0,0.12)] backdrop-blur-md"
  >
    <a href={localize('/', lang)} class="flex items-center gap-2 rounded-full py-1 pl-1.5 pr-2.5">
      <img
        src={person.avatar.src}
        alt={person.avatar.alt}
        width="28"
        height="28"
        class="h-7 w-7 rounded-full object-cover"
      />
      <span class="hidden text-sm font-extrabold tracking-tight text-ink sm:inline">{person.brand}</span>
    </a>
    {nav.map((l) => (
      <a
        href={l.href}
        class:list={[
          'rounded-full px-3 py-1.5 text-sm font-semibold transition-colors',
          isActive(l.match) ? 'bg-ink text-white' : 'text-ink-soft hover:bg-black/5',
        ]}
      >
        {l.label}
      </a>
    ))}

    {/* 한/영 토글 */}
    <div class="ml-1 flex items-center rounded-full bg-black/[0.04] p-0.5 text-xs font-bold">
      <a
        href={koHref}
        hreflang="ko"
        class:list={['rounded-full px-2 py-1 transition-colors', lang === 'ko' ? 'bg-ink text-white' : 'text-muted hover:text-ink']}
      >KO</a>
      <a
        href={enHref}
        hreflang="en"
        class:list={['rounded-full px-2 py-1 transition-colors', lang === 'en' ? 'bg-ink text-white' : 'text-muted hover:text-ink']}
      >EN</a>
    </div>
  </nav>
</div>

{/* 우측 상단 링크 (GitHub · 이력서 PDF) */}
<div class="no-print pointer-events-none fixed right-4 top-4 z-50 hidden lg:flex">
  <div class="pointer-events-auto flex items-center gap-0.5 rounded-full border border-black/5 bg-white/80 p-1.5 shadow-[0_8px_30px_rgba(0,0,0,0.12)] backdrop-blur-md">
    <a
      href={links.github.href}
      target="_blank"
      rel="noreferrer"
      aria-label={links.github.label}
      title={links.github.label}
      class="flex h-8 w-8 items-center justify-center rounded-full text-ink-soft transition-colors hover:bg-black/5 hover:text-ink"
    >
      <svg viewBox="0 0 16 16" fill="currentColor" class="h-[18px] w-[18px]" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 012-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z" />
      </svg>
    </a>
    <a
      href={links.resumePdf[lang]}
      title={t('nav.pdf.title')}
      class="flex items-center gap-1.5 rounded-full px-2.5 py-1.5 text-sm font-semibold text-ink-soft transition-colors hover:bg-black/5 hover:text-ink"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-[17px] w-[17px]" aria-hidden="true">
        <path d="M14 3H7a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8z" />
        <path d="M14 3v5h5M12 12v6M9 15l3 3 3-3" />
      </svg>
      {t('nav.pdf')}
    </a>
  </div>
</div>
