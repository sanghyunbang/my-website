---
const links = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Work' },
  { href: '/blog', label: 'Blog' },
  { href: '/resume', label: 'Resume' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<div class="no-print pointer-events-none fixed inset-x-0 top-0 z-50 flex justify-center px-4 py-4">
  <nav
    class="pointer-events-auto flex items-center gap-1 rounded-full border border-black/5 bg-white/80 p-1.5 shadow-[0_8px_30px_rgba(0,0,0,0.12)] backdrop-blur-md"
  >
    <a href="/" class="flex items-center gap-2 rounded-full py-1 pl-1.5 pr-2.5">
      <img
        src="/img/cat_profile.png"
        alt="SangHyun"
        width="30"
        height="30"
        class="h-7 w-7 rounded-full object-cover"
      />
      <span class="text-sm font-extrabold tracking-tight text-ink">SANGHYUN</span>
    </a>
    {links.map((l) => (
      <a
        href={l.href}
        class:list={[
          'rounded-full px-3.5 py-1.5 text-sm font-semibold transition-colors',
          isActive(l.href)
            ? 'bg-ink text-white'
            : 'text-ink-soft hover:bg-black/5',
        ]}
      >
        {l.label}
      </a>
    ))}
  </nav>
</div>
