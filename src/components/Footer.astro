---
import { getLang, localize, GITHUB_URL, PORTFOLIO_URL } from '../i18n';
const lang = getLang(Astro.url);
const year = new Date().getFullYear();
const links = [
  { href: GITHUB_URL, label: 'GitHub' },
  { href: localize('/resume', lang), label: 'Resume' },
  { href: PORTFOLIO_URL, label: 'Portfolio' },
];
const isExternal = (href: string) => href.startsWith('http');
---

<footer class="no-print mt-32 border-t border-line">
  <div class="mx-auto flex max-w-4xl flex-col items-center justify-between gap-4 px-6 py-10 sm:flex-row">
    <p class="text-sm text-muted">© {year} SangHyun Bang</p>
    <div class="flex gap-5">
      {links.map((l) => (
        <a
          href={l.href}
          target={isExternal(l.href) ? '_blank' : undefined}
          rel={isExternal(l.href) ? 'noreferrer' : undefined}
          class="text-sm text-muted transition-colors hover:text-ink"
        >
          {l.label}
        </a>
      ))}
    </div>
  </div>
</footer>
