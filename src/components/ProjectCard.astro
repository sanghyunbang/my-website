---
interface Props {
  title: string;
  slug: string;
  summary: string;
  tech: string[];
  highlight?: string;
  cover?: string;
  coverAlt?: string;
  award?: string;
  index?: number;
}
const { title, slug, summary, tech, highlight, cover, coverAlt, award, index } =
  Astro.props;
const num = index !== undefined ? String(index + 1).padStart(2, '0') : undefined;
---

<a
  href={`/projects/${slug}`}
  class="group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-surface transition-all duration-300 hover:-translate-y-1 hover:border-line-strong hover:shadow-[0_16px_50px_-16px_rgba(0,0,0,0.18)]"
>
  {cover && (
    <div class="relative aspect-[16/9] overflow-hidden border-b border-line">
      <img
        src={cover}
        alt={coverAlt ?? title}
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
      {award && (
        <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[11px] font-semibold text-amber-700 backdrop-blur">
          🏆 수상
        </span>
      )}
    </div>
  )}
  <div class="flex flex-1 flex-col p-7">
    {num && <span class="mb-3 font-mono text-xs text-muted">{num}</span>}
    <h3 class="text-xl font-bold tracking-tight text-ink">{title}</h3>
    <p class="mt-2 text-[15px] leading-relaxed text-ink-soft">{summary}</p>
    {highlight && (
      <p class="mt-4 border-l-2 border-accent pl-3 text-sm font-medium text-accent-ink">
        {highlight}
      </p>
    )}
    <div class="mt-5 flex flex-wrap gap-x-3 gap-y-1.5">
      {tech.slice(0, 6).map((t) => (
        <span class="font-mono text-xs text-muted">{t}</span>
      ))}
    </div>
    <span class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-ink transition-all duration-300 group-hover:gap-2">
      자세히 보기 <span class="text-accent">→</span>
    </span>
  </div>
</a>
