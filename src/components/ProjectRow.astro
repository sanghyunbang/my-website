---
import TechBadge from './TechBadge.astro';
import { localize, useT, type Lang } from '../i18n';
import { getAward, formatAward, type AwardId } from '../data/profile';

interface Props {
  title: string;
  slug: string;
  summary: string;
  tech: string[];
  highlight?: string;
  /** src/data/profile.ts awards id */
  award?: AwardId;
  cover?: string;
  coverAlt?: string;
  coverWidth?: number;
  coverHeight?: number;
  index?: number;
  lang?: Lang;
  cta?: string;
}
const { title, slug, summary, tech, highlight, award, cover, coverAlt, coverWidth, coverHeight, index = 0, lang = 'ko', cta } =
  Astro.props;
const t = useT(lang);
const href = localize(`/projects/${slug}`, lang);
const awardTitle = award ? formatAward(getAward(award), lang) : undefined;

const gradients = [
  'from-blue-500 via-indigo-500 to-violet-600',
  'from-sky-500 via-cyan-500 to-teal-600',
  'from-indigo-500 via-purple-500 to-fuchsia-600',
];
const grad = gradients[index % gradients.length];
const monogram = title.trim().charAt(0).toUpperCase();
---

<a
  href={href}
  class="group grid items-center gap-7 sm:grid-cols-[320px_1fr]"
>
  {/* thumbnail — 16:9 frame; covers are contained (never cropped) on a neutral background */}
  <div class="relative aspect-video w-full overflow-hidden rounded-2xl border border-line bg-neutral-100">
    {cover ? (
      <img
        src={cover}
        alt={coverAlt ?? title}
        width={coverWidth}
        height={coverHeight}
        class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-[1.03]"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div
        class:list={[
          'flex h-full w-full items-center justify-center bg-gradient-to-br transition-transform duration-500 group-hover:scale-105',
          grad,
        ]}
      >
        <span class="display text-7xl text-white/95">{monogram}</span>
      </div>
    )}
    {awardTitle && (
      <span
        class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[11px] font-semibold text-amber-700 backdrop-blur"
        title={awardTitle}
      >
        🏆 {t('award.badge')}
      </span>
    )}
  </div>

  {/* content */}
  <div class="flex flex-col justify-center py-1">
    <h3 class="text-2xl font-bold tracking-tight text-ink transition-colors group-hover:text-accent-ink">
      {title}
    </h3>
    <p class="mt-2 max-w-xl text-[15px] leading-relaxed text-ink-soft">{summary}</p>
    {highlight && (
      <p class="mt-3 border-l-2 border-accent pl-3 text-sm font-medium text-accent-ink">
        {highlight}
      </p>
    )}
    <div class="mt-4 flex flex-wrap gap-1.5">
      {tech.slice(0, 6).map((x) => (
        <TechBadge label={x} />
      ))}
      {tech.length > 6 && (
        <span class="inline-flex items-center rounded-lg border border-line px-2.5 py-1 text-xs font-medium text-muted">
          +{tech.length - 6}
        </span>
      )}
    </div>
    <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-ink transition-all duration-300 group-hover:gap-2">
      {cta ?? t('proj.viewmore')} <span class="text-accent">→</span>
    </span>
  </div>
</a>
