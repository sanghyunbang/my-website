---
import ProjectDetail from '../../../components/views/ProjectDetail.astro';
import { getProjects, projectSlug } from '../../../lib/content';

// kind: brief entries get no detail page
export async function getStaticPaths() {
  const projects = await getProjects('en', 'case');
  return projects.map((p) => ({
    params: { slug: projectSlug(p) },
    props: { project: p },
  }));
}
const { project } = Astro.props;
---
<ProjectDetail lang="en" project={project} />
