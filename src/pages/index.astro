---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkCard from '../components/LinkCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import PostCard from '../components/PostCard.astro';

const skills = ['Java', 'Spring', 'MSA', 'JPA', 'Kafka', 'Redis', 'Flutter'];

const linkCards = [
  {
    title: 'Resume',
    href: 'https://www.notion.so/Hi-I-m-SangHyun-321b82bc8b718076951af8d8979005ff?source=copy_link',
    description: 'Notion 이력서 — 경력 · 기술 스택 · 프로젝트',
    badge: 'Notion',
  },
  {
    title: 'Portfolio',
    href: 'https://www.figma.com/deck/lm0luFHjvmFkrk9ILnaKHZ/%ED%8F%AC%ED%8A%B8%ED%8F%B4%EB%A6%AC%EC%98%A4?node-id=1-259&t=QONEdD7IQrzUUc2f-1',
    description: 'Figma 슬라이드 포트폴리오',
    badge: 'Figma',
  },
  {
    title: 'GitHub',
    href: 'https://github.com/sanghyunbang',
    description: '코드 · 실험 프로젝트 · 저장소',
    badge: 'Code',
  },
];

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const recent = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<BaseLayout>
  {/* ── Hero (sky, Sanjay-style) ── */}
  <section class="full-bleed hero-sky">
    <div class="mx-auto flex min-h-[92vh] max-w-5xl flex-col px-6 pb-8 pt-28 sm:pt-32">
      <div class="flex flex-1 flex-col items-center gap-8 md:flex-row md:items-center md:justify-between">
        {/* text */}
        <div class="text-center md:text-left">
          <p class="text-lg font-semibold text-white/90">
            <span class="inline-block animate-pulse">👋</span> Hey, I'm <span class="font-extrabold text-white">SangHyun</span>
          </p>

          <h1 class="mt-3 text-white">
            <span class="display block text-6xl sm:text-7xl lg:text-[5.5rem]">software</span>
            <span class="font-script floaty -mt-1 block text-7xl leading-tight sm:text-8xl lg:text-[7rem]">
              engineer
            </span>
          </h1>

          <p class="mt-6 text-lg font-medium text-white/95">
            Spring 백엔드부터 Flutter 앱까지, <span class="font-bold text-white">제품이 되는 소프트웨어</span>를 만듭니다
          </p>

          <div class="mt-6 flex flex-wrap justify-center gap-2 md:justify-start">
            {skills.map((s) => (
              <span class="rounded-full border border-white/40 bg-white/15 px-3 py-1 font-mono text-xs font-medium text-white backdrop-blur-sm">
                {s}
              </span>
            ))}
          </div>
        </div>

        {/* avatar (temporary — swap for cutout photo later) */}
        <div class="shrink-0">
          <div class="floaty relative">
            <img
              src="/img/cat_profile.png"
              alt="SangHyun Bang"
              width="280"
              height="280"
              class="h-52 w-52 rounded-full border-4 border-white/70 object-cover shadow-2xl shadow-blue-900/20 sm:h-64 sm:w-64 lg:h-72 lg:w-72"
            />
          </div>
        </div>
      </div>

      {/* bottom meta */}
      <div class="mt-10 flex items-center justify-between font-mono text-xs uppercase tracking-wider text-ink-soft">
        <span class="flex items-center gap-1.5">
          Based in <span aria-hidden="true">📍</span> Seoul, KR
        </span>
        <span class="hidden sm:inline">Build + Operate</span>
      </div>
    </div>
  </section>

  {/* ── CTA row ── */}
  <section class="flex flex-wrap items-center gap-3 pt-12">
    <a
      href="/projects"
      class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
    >
      프로젝트 보기
    </a>
    <a
      href="/about"
      class="rounded-full border border-line-strong px-6 py-3 text-sm font-semibold text-ink transition-colors hover:border-ink"
    >
      About me
    </a>
    <span class="ml-auto inline-flex items-center gap-1.5 font-mono text-sm text-emerald-600">
      <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
      open to work
    </span>
  </section>

  {/* ── Selected Work ── */}
  <section class="reveal border-t border-line pt-14">
    <div class="flex items-end justify-between">
      <div>
        <p class="font-mono text-sm text-accent-ink">01 — Work</p>
        <h2 class="display mt-2 text-3xl text-ink">대표 프로젝트</h2>
      </div>
      <a
        href="/projects"
        class="link-underline text-sm font-semibold text-ink"
      >
        전체 보기 →
      </a>
    </div>
    <div class="mt-8 space-y-12">
      {projects.map((p, i) => (
        <ProjectRow
          title={p.data.title}
          slug={p.id}
          summary={p.data.summary}
          tech={p.data.tech}
          highlight={p.data.highlight}
          cover={p.data.cover}
          coverAlt={p.data.coverAlt}
          award={p.data.award}
          index={i}
        />
      ))}
    </div>
  </section>

  {/* ── Writing ── */}
  {recent.length > 0 && (
    <section class="reveal mt-24 border-t border-line pt-14">
      <div class="flex items-end justify-between">
        <div>
          <p class="font-mono text-sm text-accent-ink">02 — Writing</p>
          <h2 class="display mt-2 text-3xl text-ink">최근 글</h2>
        </div>
        <a href="/blog" class="link-underline text-sm font-semibold text-ink">
          블로그 →
        </a>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-2">
        {recent.map((p) => (
          <PostCard
            title={p.data.title}
            slug={p.id}
            description={p.data.description}
            date={p.data.date}
            series={p.data.series}
            seriesOrder={p.data.seriesOrder}
          />
        ))}
      </div>
    </section>
  )}

  {/* ── Elsewhere ── */}
  <section class="reveal mt-24 border-t border-line pt-14">
    <p class="font-mono text-sm text-accent-ink">03 — Elsewhere</p>
    <h2 class="display mt-2 text-3xl text-ink">링크</h2>
    <div class="mt-8 grid gap-3">
      {linkCards.map((card) => (
        <LinkCard {...card} />
      ))}
    </div>
  </section>
</BaseLayout>
