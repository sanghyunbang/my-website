---
import BaseLayout from '../layouts/BaseLayout.astro';

// 호버 시 우측에 뜨는 키워드 (나를 나타내는 단어)
const keywords = ['구조적 사고', '데이터 기반', '끈질긴 디버깅', '안정적인 운영', '끝까지 책임'];

// 개발 교육·프로젝트 중심 여정 (최근순)
const journey = [
  {
    org: '프로그래머스 데브코스',
    role: 'MSA 기반 Spring AI 심화 캠프 · Spring Cloud · 백엔드 프로젝트(BARO FARM)',
    period: '2025.12 – 2026.01',
    mono: 'P',
    grad: 'from-violet-500 to-fuchsia-600',
    href: '/projects/baro-farm',
  },
  {
    org: '한국관광공사 데이터 활용 공모전',
    role: 'HeatTrip 출품 · 우수상 수상',
    period: '2025.07 – 2025.11',
    mono: '🏆',
    grad: 'from-amber-500 to-orange-500',
    href: '/projects/heat-trip',
  },
  {
    org: '강남 하이미디어 · KDT 풀스택 캠프',
    role: 'Spring · React · Flutter 풀스택 · 졸업 프로젝트 우수상(HeatTrip)',
    period: '2025.01 – 2025.07',
    mono: 'KDT',
    grad: 'from-sky-500 to-cyan-600',
    href: '/projects/heat-trip',
  },
];

// 학력 (부수적 — 작게)
const education = [
  { school: '학점은행제 · 컴퓨터공학 (졸업 예정)', period: '2025.07 – 2026.08' },
  { school: '서강대학교 · 경영학 / 경제학 복수전공', period: '2015.03 – 2022.05' },
  { school: '중앙대학교 대학원 · AI학과 (휴학)', period: '2022.09 –' },
];

const contacts = [
  { label: 'GitHub', href: 'https://github.com/sanghyunbang' },
  {
    label: 'Resume',
    href: '/resume',
  },
  {
    label: 'Portfolio',
    href: 'https://www.figma.com/deck/lm0luFHjvmFkrk9ILnaKHZ/%ED%8F%AC%ED%8A%B8%ED%8F%B4%EB%A6%AC%EC%98%A4?node-id=1-259&t=QONEdD7IQrzUUc2f-1',
  },
  {
    label: 'Notion',
    href: 'https://www.notion.so/Hi-I-m-SangHyun-321b82bc8b718076951af8d8979005ff?source=copy_link',
  },
];
---

<BaseLayout title="About" description="SangHyun Bang — 서비스를 만들고 운영하는 Java/Spring 백엔드 개발자.">
  {/* ── Portrait (color → grayscale on hover, keywords reveal) ── */}
  <section class="pt-28 sm:pt-32">
    <div class="group relative mx-auto w-fit">
      <img
        src="/img/cat_profile.png"
        alt="SangHyun Bang"
        width="288"
        height="288"
        class="h-64 w-64 rounded-3xl object-cover transition-all duration-500 group-hover:scale-[1.02] group-hover:grayscale sm:h-72 sm:w-72"
      />
      <ul
        class="pointer-events-none absolute left-full top-1/2 ml-10 hidden -translate-y-1/2 space-y-2.5 font-mono text-base text-ink lg:block"
      >
        {keywords.map((k, i) => (
          <li
            class="whitespace-nowrap translate-x-3 opacity-0 transition-all duration-500 group-hover:translate-x-0 group-hover:opacity-100"
            style={`transition-delay:${i * 70}ms`}
          >
            {k}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ── Intro ── */}
  <section class="mx-auto mt-14 max-w-2xl space-y-5 text-lg leading-relaxed text-ink-soft">
    <p>
      <span class="text-ink">서비스를 직접 만들고 운영</span>하면서, 사용자 요청·데이터·인증·배포가
      하나로 이어질 때 개발이 가장 재미있었습니다. Spring Boot로 인증·검색·추천·데이터 저장과
      조회·배포까지 <span class="text-ink">끝까지 책임지는</span> 백엔드를 지향합니다.
    </p>
    <p>
      경영·경제를 먼저 공부한 덕에 <span class="text-ink">"왜 이 데이터가 필요한가"</span>를 함께
      생각하고, 강화학습 연구로 정량적으로 문제를 바라보는 습관을 들였습니다. 단순히 동작하는
      코드가 아니라 동작 이후의 구조까지 확인하는 개발자입니다.
    </p>
  </section>

  {/* ── Journey ── */}
  <section class="mt-24">
    <h2 class="display text-center text-3xl text-ink sm:text-4xl">
      My professional journey so far
    </h2>
    <div class="mx-auto mt-12 max-w-2xl space-y-3">
      {journey.map((j) => {
        const Tag = j.href ? 'a' : 'div';
        return (
          <Tag
            href={j.href}
            class:list={[
              'group flex items-center gap-4 rounded-2xl p-3 transition-colors',
              j.href ? 'hover:bg-black/[0.03]' : '',
            ]}
          >
            <div
              class:list={[
                'flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br text-sm font-bold text-white',
                j.grad,
              ]}
            >
              {j.mono}
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-bold text-ink">
                {j.org}
                {j.href && <span class="ml-1.5 text-accent opacity-0 transition-opacity group-hover:opacity-100">→</span>}
              </p>
              <p class="text-sm text-muted">{j.role}</p>
            </div>
            <span class="shrink-0 text-right font-mono text-xs text-ink-soft sm:text-sm">
              {j.period}
            </span>
          </Tag>
        );
      })}
    </div>
    {/* 학력 — 부수적, 작게 */}
    <div class="mx-auto mt-12 max-w-2xl border-t border-line pt-6">
      <p class="font-mono text-xs uppercase tracking-wider text-muted">학력</p>
      <ul class="mt-3 space-y-1.5">
        {education.map((e) => (
          <li class="flex items-baseline justify-between gap-3 text-sm text-muted">
            <span>{e.school}</span>
            <span class="shrink-0 font-mono text-xs">{e.period}</span>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-8 text-center text-sm text-muted">
      전체 경력·자격·수상은
      <a href="/resume" class="link-underline font-semibold text-accent-ink">이력서</a>에서 한눈에 볼 수 있습니다.
    </p>
  </section>

  {/* ── Let's connect ── */}
  <section class="mt-24 border-t border-line pt-12">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <h2 class="display text-3xl text-ink sm:text-4xl">Let's connect ☕</h2>
      <p class="max-w-md text-ink-soft">
        사용자와 데이터의 흐름을 이해하고, 안정적인 서비스 백엔드를 함께 만들고 싶습니다.
        편하게 연락 주세요.
      </p>
    </div>
    <div class="mt-7 flex flex-wrap items-center gap-3">
      <a
        href="/resume"
        class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
      >
        이력서 보기
      </a>
      {contacts.map((c) => (
        <a
          href={c.href}
          target={c.href.startsWith('http') ? '_blank' : undefined}
          rel={c.href.startsWith('http') ? 'noreferrer' : undefined}
          class="link-underline text-sm font-semibold text-ink-soft hover:text-ink"
        >
          {c.label}{c.href.startsWith('http') ? ' ↗' : ''}
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
